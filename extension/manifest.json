{
  "manifest_version": 3,
  "name": "MOM Live Capture",
  "description": "Botless live caption capture for MOM meetings.",
  "version": "0.1.13",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "css": ["src/content.css"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MOM Live Capture"
  }
}
