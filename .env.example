DATABASE_URL=sqlite:///./backend/mom.db
UPLOAD_DIR=backend/uploads
TRANSCRIPT_DIR=backend/transcripts

# CPU-friendly default. Use "medium" for better Hinglish accuracy if your CPU/RAM can handle it.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1

# Optional speed boost if meetings are mostly one language: en, hi, etc. Keep blank for auto-detect.
WHISPER_LANGUAGE=

# Speaker clustering is local and token-free. It is approximate in Phase 1.
ENABLE_DIARIZATION=true
MAX_SPEAKERS=4

# AI cleanup and notes can use OpenAI or Groq.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
SUMMARY_MAX_OUTPUT_TOKENS=700
SUMMARY_TIMEOUT_SECONDS=60
CHAT_MAX_OUTPUT_TOKENS=900
CHAT_TIMEOUT_SECONDS=60
CLEANUP_MAX_OUTPUT_TOKENS=4000
CLEANUP_TIMEOUT_SECONDS=90
